  "mcp": {
    "refused": {
      "voiceflow_integration.connect": {
        "cli": "integration connect",
        "guidance": "Connecting an integration requires handing over live credentials, which MCP clients may not do. Ask the user to connect this integration from the Voiceflow UI.",
        "when": "always"
      },
      "voiceflow_mcp_server.create": {
        "cli": "mcp-server create",
        "condition": "Only when a header value is literal text that carries no `{name}` reference at all.",
        "guidance": "An MCP server header value cannot be sent as literal text from an MCP client — the credential would be recorded in this conversation. Reference a project secret by name instead: the value has to carry at least one `{secret_name}` token (`{stripe_key}`, or `Bearer {stripe_key}` when the scheme prefix is needed). A header that is genuinely not a credential has to be added in the Voiceflow UI (Agent settings → MCP servers), with the Voiceflow CLI, or through the Voiceflow REST API.",
        "when": "conditional"
      },
      "voiceflow_mcp_server.update": {
        "cli": "mcp-server update",
        "condition": "Only when a header value is literal text that carries no `{name}` reference at all.",
        "guidance": "An MCP server header value cannot be sent as literal text from an MCP client — the credential would be recorded in this conversation. Reference a project secret by name instead: the value has to carry at least one `{secret_name}` token (`{stripe_key}`, or `Bearer {stripe_key}` when the scheme prefix is needed). A header that is genuinely not a credential has to be added in the Voiceflow UI (Agent settings → MCP servers), with the Voiceflow CLI, or through the Voiceflow REST API.",
        "when": "conditional"
      },
      "voiceflow_phone_number.create": {
        "cli": "phone-number create",
        "guidance": "A phone number cannot be provisioned from an MCP client, because doing so spends the workspace's money and writes carrier credentials. Buy or connect the number in the Voiceflow UI (Workspace settings → Phone numbers), with the Voiceflow CLI, or through the Voiceflow REST API, then assign it to a project with `assign`.",
        "when": "always"
      },
      "voiceflow_secret.create": {
        "cli": "secret create",
        "condition": "Only when the request body carries a non-empty `defaultValue`.",
        "guidance": "A secret value cannot be set from an MCP client. Create the secret without `defaultValue`, then set the value in the Voiceflow UI (Agent settings → Secrets), with the Voiceflow CLI, or through the Voiceflow REST API.",
        "when": "conditional"
      },
      "voiceflow_secret.set_value": {
        "cli": "secret set-value",
        "guidance": "Secret values cannot be set from an MCP client. Set the value in the Voiceflow UI (Agent settings → Secrets), with the Voiceflow CLI, or through the Voiceflow REST API.",
        "when": "always"
      }
    },
